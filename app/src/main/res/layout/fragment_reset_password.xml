<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_soft_gradient">

    <!-- Decoration bubbles -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-88dp"
        android:layout_marginEnd="-78dp"
        android:background="@drawable/bg_welcome_purple_bubble" />

    <View
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-42dp"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_welcome_white_bubble" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="44dp"
        android:src="@drawable/ic_fun_star"
        app:tint="#FFFFC107" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="118dp"
        android:layout_marginEnd="92dp"
        android:alpha="0.75"
        android:src="@drawable/ic_fun_cloud"
        app:tint="#D9C4FF" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="42dp"
        android:layout_marginTop="186dp"
        android:src="@drawable/ic_fun_sparkle"
        app:tint="#FF8FA3" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="42dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_password_title"
                        android:textColor="#1F1F1F"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/reset_password_instruction"
                        android:textColor="#666666"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_mascot_owl_study" />

            </LinearLayout>

            <!-- Main card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_password_otp_title"
                    android:textColor="#1F1F1F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/reset_password_otp_subtitle"
                    android:textColor="#777777"
                    android:textSize="13.5sp" />

                <!-- Email -->
                <TextView
                    android:id="@+id/txtEmailSent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="@string/reset_password_email_sent_default"
                    android:textColor="#6D5E87"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnResendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auth_outline_button_soft"
                    android:text="@string/resend_verification_code"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- OTP -->
                <EditText
                    android:id="@+id/edtOtp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_auth_input_soft"
                    android:hint="@string/verification_code"
                    android:inputType="number"
                    android:maxLength="8"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="#1F1F1F"
                    android:textColorHint="#9A8FB2"
                    android:textSize="15.5sp" />

                <!-- New password -->
                <EditText
                    android:id="@+id/edtNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_auth_input_soft"
                    android:hint="@string/new_password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="#1F1F1F"
                    android:textColorHint="#9A8FB2"
                    android:textSize="15.5sp" />

                <!-- Confirm password -->
                <EditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_auth_input_soft"
                    android:hint="@string/confirm_new_password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="#1F1F1F"
                    android:textColorHint="#9A8FB2"
                    android:textSize="15.5sp" />

                <!-- Hint box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_auth_input_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_fun_star"
                        app:tint="#FFB300" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/reset_password_password_hint"
                        android:textColor="#6D5E87"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Reset button -->
                <Button
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_auth_primary_button"
                    android:text="@string/reset_password"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <!-- Back button -->
                <Button
                    android:id="@+id/btnBackToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_auth_outline_button_soft"
                    android:text="@string/back_to_login"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>