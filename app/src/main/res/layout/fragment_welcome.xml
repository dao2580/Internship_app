<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_soft_gradient">

    <!-- Top decorative bubble -->
    <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-90dp"
        android:background="@drawable/bg_welcome_purple_bubble" />

    <View
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-55dp"
        android:layout_marginTop="58dp"
        android:background="@drawable/bg_welcome_white_bubble" />

    <!-- Stars -->
    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="44dp"
        android:src="@drawable/ic_fun_star"
        app:tint="#FFFFC107" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="38dp"
        android:layout_marginTop="176dp"
        android:src="@drawable/ic_fun_sparkle"
        app:tint="@color/primary_color" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center|end"
        android:layout_marginEnd="26dp"
        android:src="@drawable/ic_fun_star"
        app:tint="#FFFFC107" />

    <!-- Bottom cloud area -->
    <View
        android:layout_width="260dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-78dp"
        android:layout_marginBottom="-28dp"
        android:background="@drawable/bg_welcome_cloud" />

    <View
        android:layout_width="280dp"
        android:layout_height="104dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-34dp"
        android:background="@drawable/bg_welcome_cloud" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:minHeight="720dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="54dp"
            android:paddingEnd="28dp"
            android:paddingBottom="34dp">

            <!-- App name -->
            <TextView
                android:id="@+id/camStudyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="4"
                android:text="@string/app_name"
                android:textColor="@color/primary_color"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Học từ mới,\nthế giới mở rộng với camera!"
                android:textColor="@color/primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Hero illustration -->
            <FrameLayout
                android:id="@+id/iconRow"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:layout_marginTop="18dp">

                <View
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_welcome_hero_circle" />

                <View
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_welcome_white_bubble" />

                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="36dp"
                    android:background="@drawable/bg_welcome_white_bubble" />

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="42dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/primary_color" />

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="54dp"
                    android:layout_marginEnd="34dp"
                    android:background="@drawable/bg_welcome_small_card"
                    android:gravity="center"
                    android:text="Aa"
                    android:textColor="@color/primary_color"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/anh" />

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_fun_star"
                    app:tint="#FFFFC107" />

            </FrameLayout>

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:gravity="center"
                android:text="Khám phá đồ vật xung quanh\nvà học từ vựng thật vui!"
                android:textColor="@color/secondary_text"
                android:textSize="15sp" />

            <!-- Dots decoration -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_welcome_dot_active" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_welcome_dot_inactive" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_welcome_dot_inactive" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_welcome_dot_inactive" />

            </LinearLayout>

            <!-- Start button -->
            <Button
                android:id="@+id/btnGoLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_welcome_primary_button"
                android:elevation="4dp"
                android:padding="12dp"
                android:text="@string/start"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Đăng nhập để tiếp tục"
                android:textColor="@color/secondary_text"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>