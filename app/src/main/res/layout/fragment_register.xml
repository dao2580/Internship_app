<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_soft_gradient">

    <!-- Top decorations -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-92dp"
        android:layout_marginEnd="-82dp"
        android:background="@drawable/bg_welcome_purple_bubble" />

    <View
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-42dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/bg_welcome_white_bubble" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="46dp"
        android:src="@drawable/ic_fun_star"
        app:tint="#FFFFC107" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="44dp"
        android:layout_marginTop="170dp"
        android:src="@drawable/ic_fun_sparkle"
        app:tint="@color/primary_color" />

    <!-- Bottom clouds -->
    <View
        android:layout_width="260dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-88dp"
        android:layout_marginBottom="-28dp"
        android:background="@drawable/bg_welcome_cloud" />

    <View
        android:layout_width="280dp"
        android:layout_height="104dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-34dp"
        android:background="@drawable/bg_welcome_cloud" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="720dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="34dp">

            <!-- Top register card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="#226200EE"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_login_top_card">

                    <View
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-34dp"
                        android:layout_marginEnd="-30dp"
                        android:background="@drawable/bg_home_soft_purple_circle" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="18dp"
                        android:src="@drawable/ic_fun_star"
                        app:tint="#FFFFC107" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="22dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_account"
                                android:textColor="@color/primary_text"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/register_subtitle"
                                android:textColor="@color/secondary_text"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:layout_marginStart="8dp"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/anh" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Register form card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp"
                app:strokeColor="#226200EE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register"
                        android:textColor="@color/primary_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tạo tài khoản để bắt đầu học cùng CamStudy"
                        android:textColor="@color/secondary_text"
                        android:textSize="14sp" />

                    <!-- Email input -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_auth_input_soft">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="16dp"
                            android:src="@android:drawable/ic_dialog_email"
                            app:tint="@color/secondary_text" />

                        <EditText
                            android:id="@+id/edtEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="@string/email"
                            android:inputType="textEmailAddress"
                            android:paddingStart="52dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true"
                            android:textColor="@color/primary_text"
                            android:textColorHint="@color/secondary_text"
                            android:textSize="15sp" />

                    </FrameLayout>

                    <!-- Password input -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_auth_input_soft">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="16dp"
                            android:src="@android:drawable/ic_lock_lock"
                            app:tint="@color/secondary_text" />

                        <EditText
                            android:id="@+id/edtPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="@string/password"
                            android:inputType="textPassword"
                            android:paddingStart="52dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true"
                            android:textColor="@color/primary_text"
                            android:textColorHint="@color/secondary_text"
                            android:textSize="15sp" />

                    </FrameLayout>

                    <!-- Confirm password input -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_auth_input_soft">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="16dp"
                            android:src="@android:drawable/ic_lock_lock"
                            app:tint="@color/secondary_text" />

                        <EditText
                            android:id="@+id/edtConfirmPass"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="@string/confirm_password"
                            android:inputType="textPassword"
                            android:paddingStart="52dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true"
                            android:textColor="@color/primary_text"
                            android:textColorHint="@color/secondary_text"
                            android:textSize="15sp" />

                    </FrameLayout>

                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_welcome_primary_button"
                        android:backgroundTint="@null"
                        android:elevation="4dp"
                        android:text="@string/register"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#1F6200EE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:text="hoặc"
                            android:textColor="@color/secondary_text"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#1F6200EE" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnBackToLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_auth_outline_button_soft"
                        android:backgroundTint="@null"
                        android:text="@string/back_to_login"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>