<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".EmbeddedCameraFragment">

    <!-- Camera Preview - FULLSCREEN -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dark top overlay for better visibility -->
    <View
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_camera_top_fade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_camera_back"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="42dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#99000000"
        app:cornerRadius="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cute small stars, only decoration -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="92dp"
        android:src="@drawable/ic_fun_star"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFC107" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="34dp"
        android:src="@drawable/ic_fun_sparkle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFFFF" />

    <!-- Hint chip -->
    <TextView
        android:id="@+id/txt_camera_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="86dp"
        android:background="@drawable/bg_camera_hint_chip"
        android:elevation="4dp"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/camera_frame_hint"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center scan corner frame -->
    <FrameLayout
        android:id="@+id/camera_scan_frame"
        android:layout_width="280dp"
        android:layout_height="360dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toTopOf="@+id/zoom_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_camera_hint">

        <!-- top left corner -->
        <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="start|top"
            android:background="@drawable/bg_camera_corner_line" />

        <View
            android:layout_width="5dp"
            android:layout_height="46dp"
            android:layout_gravity="start|top"
            android:background="@drawable/bg_camera_corner_line" />

        <!-- top right corner -->
        <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="end|top"
            android:background="@drawable/bg_camera_corner_line" />

        <View
            android:layout_width="5dp"
            android:layout_height="46dp"
            android:layout_gravity="end|top"
            android:background="@drawable/bg_camera_corner_line" />

        <!-- bottom left corner -->
        <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/bg_camera_corner_line" />

        <View
            android:layout_width="5dp"
            android:layout_height="46dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/bg_camera_corner_line" />

        <!-- bottom right corner -->
        <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="end|bottom"
            android:background="@drawable/bg_camera_corner_line" />

        <View
            android:layout_width="5dp"
            android:layout_height="46dp"
            android:layout_gravity="end|bottom"
            android:background="@drawable/bg_camera_corner_line" />

    </FrameLayout>

    <!-- Bottom dark panel -->
    <View
        android:id="@+id/camera_bottom_panel"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:background="@drawable/bg_camera_bottom_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Permission Layout -->
    <LinearLayout
        android:id="@+id/permission_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_welcome_soft_gradient"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="5dp"
            app:strokeColor="#336200EE"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_welcome_card">

                <View
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-28dp"
                    android:layout_marginEnd="-26dp"
                    android:background="@drawable/bg_home_soft_purple_circle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="28dp">

                    <FrameLayout
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/bg_home_soft_purple_circle">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/camera_icon"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/primary_color" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/camera_permission_required"
                        android:textAlignment="center"
                        android:textColor="@color/primary_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="22dp"
                        android:gravity="center"
                        android:text="CamStudy cần camera để nhận diện đồ vật và giúp bạn học từ mới."
                        android:textColor="@color/secondary_text"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant_permission"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="@string/grant_permission"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary_color"
                        app:cornerRadius="18dp" />

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Zoom Control - giữ nguyên id -->
    <LinearLayout
        android:id="@+id/zoom_control"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_camera_zoom_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/camera_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_zoom_1x"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:minWidth="48dp"
            android:text="@string/_1_0x"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:cornerRadius="18dp"
            app:strokeColor="@android:color/white"
            tools:ignore="DuplicateSpeakableTextCheck" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/zoom_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="@android:color/white"
            android:thumbTint="@android:color/white" />

        <TextView
            android:id="@+id/txt_zoom_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:minWidth="40dp"
            android:text="@string/_1_0x"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_zoom_2x"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minWidth="48dp"
            android:text="@string/_2_0x"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:cornerRadius="18dp"
            app:strokeColor="@android:color/white" />

    </LinearLayout>

    <!-- Camera Controls - giữ nguyên id -->
    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/camera_controls"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:contentDescription="@string/flash_button"
            android:src="@drawable/ic_flash"
            app:backgroundTint="@color/surface_color"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabSize="mini"
            app:tint="@color/primary_text"
            tools:ignore="RedundantDescriptionCheck" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_capture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:contentDescription="@string/capture"
            android:src="@drawable/ic_camera_capture"
            app:backgroundTint="@color/primary_color"
            app:borderWidth="0dp"
            app:elevation="8dp"
            app:fabSize="normal"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:contentDescription="@string/switch_camera"
            android:src="@drawable/ic_switch_camera"
            app:backgroundTint="@color/surface_color"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabSize="mini"
            app:tint="@color/primary_text" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>