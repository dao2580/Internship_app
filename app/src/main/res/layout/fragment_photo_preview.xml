<?xml version="1.0" encoding="utf-8"?>

<!--
 ~ Project: My Application
 ~ File: fragment_photo_preview.xml
 -->

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Preview image + overlay -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toTopOf="@+id/detection_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <vn.edu.usth.myapplication.PhotoPreviewOverlayView
            android:id="@+id/preview_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- Top dark fade -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_photo_top_fade" />

        <!-- Small decorative stars -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="78dp"
            android:src="@drawable/ic_fun_star"
            app:tint="#FFFFC107" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="98dp"
            android:layout_marginEnd="28dp"
            android:src="@drawable/ic_fun_sparkle"
            app:tint="@android:color/white" />

        <!-- Scan corner frame decoration -->
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="360dp"
            android:layout_gravity="center">

            <View
                android:layout_width="46dp"
                android:layout_height="5dp"
                android:layout_gravity="start|top"
                android:background="@drawable/bg_photo_corner_line" />

            <View
                android:layout_width="5dp"
                android:layout_height="46dp"
                android:layout_gravity="start|top"
                android:background="@drawable/bg_photo_corner_line" />

            <View
                android:layout_width="46dp"
                android:layout_height="5dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_photo_corner_line" />

            <View
                android:layout_width="5dp"
                android:layout_height="46dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_photo_corner_line" />

            <View
                android:layout_width="46dp"
                android:layout_height="5dp"
                android:layout_gravity="start|bottom"
                android:background="@drawable/bg_photo_corner_line" />

            <View
                android:layout_width="5dp"
                android:layout_height="46dp"
                android:layout_gravity="start|bottom"
                android:background="@drawable/bg_photo_corner_line" />

            <View
                android:layout_width="46dp"
                android:layout_height="5dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_photo_corner_line" />

            <View
                android:layout_width="5dp"
                android:layout_height="46dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_photo_corner_line" />

        </FrameLayout>

    </FrameLayout>

    <!-- Bottom info + actions -->
    <LinearLayout
        android:id="@+id/detection_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:background="@drawable/bg_photo_bottom_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Detected result chip -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-18dp"
                android:background="@drawable/bg_photo_soft_purple_circle" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_fun_star"
                app:tint="#FFFFC107" />

            <TextView
                android:id="@+id/txt_detected_objects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_photo_detected_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp"
                android:text="Không phát hiện vật thể"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_back_to_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Back"
                app:backgroundTint="#EDE1FF"
                app:borderWidth="0dp"
                app:elevation="6dp"
                app:maxImageSize="28dp"
                app:srcCompat="@android:drawable/ic_media_previous"
                app:tint="@color/primary_text" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_save_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:contentDescription="Save Photo"
                android:visibility="gone"
                app:backgroundTint="@color/primary_color"
                app:borderWidth="0dp"
                app:elevation="6dp"
                app:maxImageSize="24dp"
                app:srcCompat="@android:drawable/ic_menu_save"
                app:tint="@android:color/white" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/btn_proceed_translation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/proceed_to_translation"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="18dp"
                app:elevation="6dp"
                app:icon="@android:drawable/ic_menu_set_as"
                app:iconTint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>